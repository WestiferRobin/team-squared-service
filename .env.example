# Disposable developer credentials only. Copy to .env.local, .env.dev or .env.test.
# Use simple shell-compatible values without connection-string delimiters.
POSTGRES_USER=service
POSTGRES_PASSWORD=change_me_test_only

# Compose files supply mode-specific DB/port defaults. Leave these unset unless
# overriding a LOCAL or DEV port. TEST scripts assign isolated ephemeral ports.
# POSTGRES_PORT=
# REDIS_PORT=
# API_PORT=
